{
  "name": "sanity-plugin-link-picker",
  "version": "2.0.0",
  "description": "A small Sanity Studio link field for choosing a label, a URL, or a weak reference.",
  "keywords": [
    "sanity",
    "sanity-plugin"
  ],
  "homepage": "https://github.com/dennisregalado/sanity-plugin-link-picker#readme",
  "bugs": {
    "url": "https://github.com/dennisregalado/sanity-plugin-link-picker/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dennisregalado/sanity-plugin-link-picker.git"
  },
  "license": "MIT",
  "author": "Dennis Regalado <dennis@baggy.studio>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "browserslist": "extends @sanity/browserslist-config",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "plugin-kit verify-package --silent && pkg-utils build --strict --check --clean",
    "format": "prettier --write --cache --ignore-unknown .",
    "link-watch": "plugin-kit link-watch",
    "lint": "eslint .",
    "prepublishOnly": "npm run typecheck && npm run build",
    "typecheck": "tsc --noEmit",
    "watch": "pkg-utils watch --strict"
  },
  "dependencies": {
    "@sanity/util": "^6.2.0",
    "@tanstack/react-virtual": "^3.14.5",
    "lucide-react": "^1.22.0"
  },
  "devDependencies": {
    "@sanity/icons": "^5.4.0",
    "@sanity/pkg-utils": "^10.7.2",
    "@sanity/plugin-kit": "^6.0.0",
    "@sanity/ui": "^4.4.12",
    "@types/react": "^19.2.17",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-sanity": "^7.1.4",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.1",
    "prettier-plugin-packagejson": "^3.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanity": "^6.23.0",
    "styled-components": "^6.4.3",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@sanity/icons": "^5",
    "@sanity/ui": "^4",
    "react": "^18 || ^19",
    "sanity": "^6"
  },
  "engines": {
    "node": ">=20.19 <22 || >=22.12"
  }
}
