{
  "name": "sanity-plugin-link-picker",
  "version": "2.0.0",
  "description": "A small Sanity Studio link field for choosing a label, a URL, or a weak reference.",
  "keywords": [
    "sanity",
    "sanity-plugin"
  ],
  "homepage": "https://github.com/dennisregalado/sanity-plugin-link-picker#readme",
  "bugs": {
    "url": "https://github.com/dennisregalado/sanity-plugin-link-picker/issues"
  },
  "license": "MIT",
  "author": "Dennis Regalado <dennis@baggy.studio>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dennisregalado/sanity-plugin-link-picker.git"
  },
  "files": [
    "dist",
    "MIGRATION.md"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "plugin-kit verify-package --silent && pkg-utils build --strict --check --clean",
    "dev": "cd dev && sanity dev",
    "format": "oxfmt",
    "link-watch": "plugin-kit link-watch",
    "lint": "oxlint",
    "prepublishOnly": "npm run build",
    "watch": "pkg-utils watch --strict"
  },
  "dependencies": {
    "@sanity/icons": "^5.2.1",
    "@sanity/ui": "^4.0.3",
    "@tanstack/react-virtual": "^3.14.5",
    "lucide-react": "^1.22.0"
  },
  "devDependencies": {
    "@sanity/browserslist-config": "^1.0.5",
    "@sanity/pkg-utils": "^13.0.18",
    "@sanity/plugin-kit": "^10.1.1",
    "@types/react": "^19.2.17",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanity": "^6.23.0",
    "styled-components": "^6.4.3",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": "^19.2",
    "sanity": "^6.10.0"
  },
  "browserslist": "extends @sanity/browserslist-config",
  "engines": {
    "node": ">=20.19 <22 || >=22.12"
  }
}
